# ---- 开元六爻 环境变量样例 ----
# 复制为 .env 并修改；.env 已被 .gitignore 排除，切勿提交。

# 管理员账号（必填，务必修改默认密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 会话签名密钥（必填，至少 32 位随机字符串；生产模式缺失或过短将拒绝启动）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-random-32-char-secret

# 可选：AI API Key 环境变量覆盖（仅服务端进程可读，§54-9）
# AI_API_KEY=
